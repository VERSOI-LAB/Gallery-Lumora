# Supabase project settings
# Supabase 대시보드 > Project Settings > API 에서 값을 복사해서 채우세요.
# https://supabase.com/dashboard/project/_/settings/api

# Project URL (예: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "Publishable key" (anon/public key) — 브라우저에 노출되어도 되는 키입니다.
# service_role 키는 절대 여기에 넣지 마세요.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# /admin 전체를 보호하는 공유 비밀번호입니다. (서버에서만 사용되며 브라우저에 노출되지 않습니다.)
# 배포 환경(Vercel 등)에도 별도로 설정해야 합니다.
ADMIN_PASSWORD=

# service_role 키 (Supabase 대시보드 > Project Settings > API > service_role).
# RLS를 완전히 우회하므로 서버 전용 admin 쓰기 작업에만 사용됩니다.
# 절대 NEXT_PUBLIC_ 접두사를 붙이거나 브라우저에 노출하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# TossPayments 결제위젯
# 개발자센터 > API 키 > "주문서형·결제창형 연동 키(결제위젯 연동 키)" 섹션의 키를 사용합니다.
#   - 실결제: 라이브 탭의 live_gck_... / live_gsk_...
#   - 테스트: 테스트 탭의 test_gck_... / test_gsk_...
# "API 개별 연동 키"(live_ck_/live_sk_)는 결제위젯과 호환되지 않습니다.
# 클라이언트 키와 시크릿 키는 반드시 같은 섹션·같은 모드(라이브/테스트)의 짝이어야 합니다.
# 비워두면 TossPayments 공식 문서의 공개 테스트 키(실 결제 승인 불가)로 동작합니다.
# https://docs.tosspayments.com/guides/payment-widget/integration
NEXT_PUBLIC_TOSS_CLIENT_KEY=
# 시크릿 키는 서버 전용입니다. NEXT_PUBLIC_ 접두사를 붙이거나 커밋하지 마세요.
TOSS_WIDGET_SECRET_KEY=
